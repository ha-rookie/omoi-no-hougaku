{
  "name": "想いの方角 Share PoC",
  "short_name": "想いの方角PoC",
  "description": "Google Maps Androidの共有内容を確認するためのPoC",
  "start_url": "/share-target-poc.html",
  "scope": "/",
  "display": "standalone",
  "background_color": "#f5f5f4",
  "theme_color": "#f5f5f4",
  "icons": [
    {
      "src": "/share-target-icon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any maskable"
    }
  ],
  "share_target": {
    "action": "/share-target",
    "method": "POST",
    "enctype": "application/x-www-form-urlencoded",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url"
    }
  }
}
