{
  "name": "想いの方角",
  "short_name": "想いの方角",
  "description": "保存した大切な場所が、今いる場所からどの方角にあるかをコンパスと地図で確認できるWebアプリ",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "background_color": "#F5F2EA",
  "theme_color": "#F5F2EA",
  "icons": [
    {
      "src": "/assets/app-icon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any maskable"
    }
  ],
  "share_target": {
    "action": "/share-target",
    "method": "POST",
    "enctype": "application/x-www-form-urlencoded",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url"
    }
  }
}
