{
  "id": "/",
  "name": "想いの方角",
  "short_name": "想いの方角",
  "lang": "ja-JP",
  "description": "保存した大切な場所が、今いる場所からどの方角にあるかをコンパスと地図で確認できるWebアプリ",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "background_color": "#F5F2EA",
  "theme_color": "#F5F2EA",
  "icons": [
    {
      "src": "/assets/icons/generated/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/assets/icons/generated/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/assets/icons/generated/icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "share_target": {
    "action": "/share-target",
    "method": "POST",
    "enctype": "application/x-www-form-urlencoded",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url"
    }
  }
